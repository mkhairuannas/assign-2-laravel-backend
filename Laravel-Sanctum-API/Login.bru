meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "test@example.com",
    "password": "password"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.token) {
    bru.setEnvVar("token", data.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
